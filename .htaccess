<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to .env and sensitive dot files
    RewriteRule ^\.env - [F,L,NC]
    RewriteRule ^composer\.(json|lock) - [F,L,NC]
    RewriteRule ^package\.(json|lock) - [F,L,NC]

    # Route all traffic to Laravel's public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

